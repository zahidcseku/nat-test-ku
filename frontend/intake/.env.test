# NAT-TEST Intake Service - Test Environment Configuration
# This file is specifically for testing the payment flow

# Database Configuration (Local test database)
DB_HOST=localhost
DB_NAME=nattest_regs_test
DB_USER=nattest_reg_test
DB_PASS=test_password_123

# Security Configuration
IP_SALT=test_salt_for_testing_only

# CORS Configuration
ALLOWED_ORIGINS=*

# Rate Limiting Configuration (Relaxed for testing)
RATE_LIMIT_MINUTE=100
RATE_LIMIT_DAY=1000

# Environment
APP_ENV=testing

# SSLCommerz Payment Gateway Configuration (SANDBOX/TEST MODE)
SSLCZ_STORE_ID=test_box_store_id
SSLCZ_STORE_PASSWORD=test_box_password
SSLCZ_MODE=sandbox
SSLCZ_SUCCESS_URL=http://localhost:8080/intake/payment-return.php?outcome=success
SSLCZ_FAIL_URL=http://localhost:8080/intake/payment-return.php?outcome=fail
SSLCZ_CANCEL_URL=http://localhost:8080/intake/payment-return.php?outcome=cancel
SSLCZ_IPN_URL=http://localhost:8080/intake/payment-ipn.php

# Test Configuration
TEST_MODE=true
MOCK_SSLCOMMERZ=true
SKIP_IPN_VERIFICATION=true