# Environment configuration
.env

# Log files
logs/
*.log

# Uploaded files (these should be pulled by admin service, not committed)
uploads/

# Database dumps (except migrations)
!migrations/*.sql
!*.sqlite
!*.db

# Backup files
*.bak
*.backup
*.old
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.sublime-*

# Temporary files
*.tmp
*.temp
