    {
      "id": "4e083033-eed9-4b5e-b4ab-edac4c81ce4f",
      "type": "benefits_heading",
      "display_order": 7,
      "is_active": true,
      "content": {
        "line1": "Why Candidates Choose NAT?",
        "line2_italic": "",
        "line2_text": "",
        "full_html": "Why Candidates Choose NAT?"
      }
    },
    {
      "id": "ae0f5ae3-36f1-47de-9656-cb54447386db",
      "type": "benefit_card_1",
      "display_order": 8,
      "is_active": true,
      "content": {
        "text": "While the JLPT is typically held only twice a year, the NAT-TEST is held six times a year. This allows students to check their progress more frequently and meet tight application deadlines for schools or visas."
      }
    },
    {
      "id": "b1c2d3e4-f5g6-7890-1234-567890abcdef",
      "type": "benefit_card_2",
      "display_order": 9,
      "is_active": true,
      "content": {
        "text": "The format and types of questions are based on the same guidelines as the JLPT. For instance, Level 5 of the NAT-TEST is directly equivalent to the N5 level of the JLPT."
      }
    },
    {
      "id": "c2d3e4f5-g6h7-8901-2345-678901bcdefg",
      "type": "benefit_card_3",
      "display_order": 10,
      "is_active": true,
      "content": {
        "text": "Detailed score reports are issued within three weeks of the exam. This report breaks down your performance by section, making it easy to identify your strengths and weaknesses."
      }
    },
    {
      "id": "d3e4f5g6-h7i8-9012-3456-789012cdefgh",
      "type": "benefit_card_4",
      "display_order": 11,
      "is_active": true,
      "content": {
        "text": "The test has a decades-long record of success and is used by Japanese language schools and educational centers worldwide for performance measurement and guidance counseling."
      }
    },
