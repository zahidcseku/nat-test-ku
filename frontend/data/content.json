    {
      "id": "21e9bbdb-a5fe-4c78-85d4-b9e7c527315c",
      "type": "hero_description",
      "display_order": 3,
      "is_active": true,
      "content": {
        "text": "Start Your Japanese Language Journey Today\nWelcome to the official page for the Japanese Language NAT-TEST Khulna center. As an authorized testing partner, we provide a streamlined platform for students and professionals to certify their Japanese proficiency.\n\nThe NAT-TEST is more than just an exam; it is a bridge to your future in Japan. Join thousands of successful candidates who have used this certification to unlock new opportunities and achieve their dreams.\n\nThe Japanese Language NAT-TEST is designed, organized, and administered by Senmon Kyouiku Publishing Co., Ltd.",
        "html": "<p class=\"animate-fade-in-up opacity-0 delay-300 text-base md:text-lg text-secondary max-w-lg leading-relaxed font-normal tracking-wide\">\n            <p><strong>Start Your Japanese Language Journey Today</strong></p>\n            <p>Welcome to the official page for the Japanese Language NAT-TEST Khulna center. As an authorized testing partner, we provide a streamlined platform for students and professionals to certify their Japanese proficiency.</p>\n            <p>\n              The NAT-TEST is more than just an exam; it is a bridge to your future in Japan. \n              Join thousands of successful candidates who have used this certification to unlock \n              new opportunities and achieve their dreams. \n            </p>\n            <p>\n              The Japanese Language NAT-TEST is designed, organized, and administered by \n              <a href=\"http://www.nat-test.com/en/about.html\"><strong>Senmon Kyouiku Publishing Co., Ltd</strong></a>.\n            </p>\n          </p>"
      }
    },
