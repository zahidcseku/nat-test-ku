# Database Configuration
DB_HOST=localhost
DB_NAME=nattest_regs
DB_USER=nattest_reg
DB_PASS=your_password_here

# SMTP Configuration
SMTP_HOST=smtp.ku.ac.bd
SMTP_PORT=587
SMTP_USER=nat-test@ku.ac.bd
SMTP_PASS=your_smtp_password
SMTP_FROM=nat-test@ku.ac.bd
SMTP_FROM_NAME=NAT-TEST Khulna

# Session Configuration
SESSION_NAME=nat_test_admin
SESSION_LIFETIME=1800

# Security
CSRF_TOKEN_NAME=csrf_token
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=900

# File Upload
MAX_UPLOAD_SIZE=209715200
ALLOWED_FILE_TYPES=application/pdf,application/zip
UPLOAD_PATH=uploads/

# Broadcast email pacing: pause in milliseconds between individual emails.
# The university SMTP relay throttles rapid bursts; 1000ms (default) kept
# large sends below the cutoff.
BROADCAST_SEND_DELAY_MS=1000

# Registration Sheet export template (absolute path recommended in production)
REGISTRATION_SHEET_TEMPLATE=/full/path/to/frontend/admin/templates/Registration_Sheet_ver.30.xlsx
