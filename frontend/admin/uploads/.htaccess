# Admission tickets, score reports and exam guides contain applicant PII
# (name, photo, registration number, results) and filenames are structured
# sequential examinee IDs — the tree must never be enumerable or directly
# fetchable. Authenticated viewing goes through api/files/download.php.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Inner layers (defense in depth): never execute anything from this tree
<FilesMatch "(?i)\.(php\d?|phtml|phar|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
