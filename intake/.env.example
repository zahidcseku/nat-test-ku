# NAT-TEST Intake Service - Environment Configuration
# Copy this file to .env and fill in your actual values
# The .env file should NOT be committed to version control

# Database Configuration
DB_HOST=localhost
DB_NAME=nat_test_intake
DB_USER=intake_user
DB_PASS=your_secure_database_password

# Security Configuration
# Generate a random salt for IP hashing: openssl rand -hex 32
IP_SALT=your_random_ip_hash_salt_here

# CORS Configuration
# Comma-separated list of allowed origins (use * for development only)
# Example: https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=*

# File Upload Configuration
# Maximum file size in bytes (default: 5MB = 5242880)
# MAX_FILE_SIZE=5242880

# Rate Limiting Configuration
# Requests per minute per IP
RATE_LIMIT_MINUTE=5
# Requests per day per IP
RATE_LIMIT_DAY=20

# Honeypot Configuration
# Name of the honeypot field (must match frontend)
HONEYPOT_FIELD=website

# Environment
# Set to 'production' in production, 'development' for local
APP_ENV=development
