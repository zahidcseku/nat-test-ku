# NAT-TEST Intake Service - Apache Security Configuration
# Protects the intake service and prevents unauthorized access

# Disable directory browsing
Options -Indexes

# Prevent access to sensitive files
<FilesMatch "^(config\.php|security\.php|validate\.php|upload\.php|\.env|init\.sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Prevent access to log files
<FilesMatch "\.log$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Protect uploads directory from direct access
<Directory "uploads">
    Order Allow,Deny
    Deny from all
</Directory>

# Protect logs directory from direct access
<Directory "logs">
    Order Allow,Deny
    Deny from all
</Directory>

# Only allow POST requests to register.php
<Files "register.php">
    <IfModule mod_rewrite.c>
        RewriteEngine On
        # Allow POST requests
        RewriteCond %{REQUEST_METHOD} !=POST
        RewriteRule ^ - [F]
    </IfModule>
</Files>

# Set security headers
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Prevent clickjacking
    Header set X-Frame-Options "DENY"

    # Enable XSS protection
    Header set X-XSS-Protection "1; mode=block"

    # Strict transport security (uncomment if using HTTPS)
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Content security policy (adjust as needed)
    Header set Content-Security-Policy "default-src 'self'"
</IfModule>

# CORS configuration (adjust origins as needed)
<IfModule mod_headers.c>
    # Allow cross-origin requests from your frontend domain
    # Replace with your actual frontend domain
    # Header set Access-Control-Allow-Origin "https://your-frontend-domain.com"

    # For development (allow all origins)
    Header set Access-Control-Allow-Origin "*"

    # Allow specific headers
    Header set Access-Control-Allow-Headers "Content-Type, X-CSRF-Token"

    # Allow POST and OPTIONS methods
    Header set Access-Control-Allow-Methods "POST, OPTIONS"

    # Cache preflight responses for 24 hours
    Header set Access-Control-Max-Age "86400"
</IfModule>

# Handle preflight OPTIONS requests
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ register.php [L]
</IfModule>

# Limit file upload size (must be larger than MAX_FILE_SIZE in PHP)
php_value upload_max_filesize 6M
php_value post_max_size 8M

# Set execution time limit
php_value max_execution_time 300
php_value max_input_time 300

# Disable error display (log to file instead)
php_value display_errors "Off"
php_value log_errors "On"

# Enable UTF-8 encoding
AddDefaultCharset UTF-8

# Prevent access to backup files
<FilesMatch "(\.bak|\.backup|\.old|\.swp|~)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Prevent access to hidden files
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Redirect root to register.php (optional)
# DirectoryIndex register.php

# Custom error pages
ErrorDocument 400 "<h1>Bad Request</h1>"
ErrorDocument 403 "<h1>Forbidden</h1>"
ErrorDocument 404 "<h1>Not Found</h1>"
ErrorDocument 405 "<h1>Method Not Allowed</h1>"
ErrorDocument 500 "<h1>Internal Server Error</h1>"
